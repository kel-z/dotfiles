# Ignore OS-generated files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db

# Ignore sensitive files
*.key
*.pem
*.p12
id_rsa*
id_ed25519*

# Ignore temporary files
*.tmp
*.temp
*.swp
*.swo
*~

# Ignore logs
*.log

# Ignore nvim files
Session.vim
.Session.vim
nvim/.config/nvim/lazy-lock.json

# Ignore tmux plugin diffs
tmux/.tmux/plugins/tmux-thumbs/

# Ignore local backup/lock artifacts
*.bak
package-lock.json

# Local-only agent instructions (machine-specific)
AGENTS.md

# Local-only packages (machine-specific, not shared)
jcode/

# Editor tool artifacts
*.broken-*

# omp runtime state + machine-local config (stow folds ~/.omp/agent into the repo)
omp/.omp/agent/*
!omp/.omp/agent/config.yml
!omp/.omp/agent/mcp.json
omp/.omp/run/

# opencode local state
opencode/.config/opencode/cli.json
opencode/.config/opencode/service.json
